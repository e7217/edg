{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Is the gateway keeping up?",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "id": 1,
      "title": "Sink backlog",
      "description": "Messages waiting in JetStream for the VM sink's durable consumer. A sustained climb means VictoriaMetrics is slower than the plant; the stream eventually hits max_bytes and discards the oldest data (ADR 0001).",
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1000
              },
              {
                "color": "red",
                "value": 10000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max(edg_core_sink_consumer_pending{job=\"edg-core\", instance=~\"$instance\"})",
          "legendFormat": "pending",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Stream usage",
      "description": "JetStream bytes against the configured max_bytes. At 100% JetStream discards the oldest messages (DiscardOld, ADR 0001).",
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 5,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max(edg_core_js_bytes{job=\"edg-core\", instance=~\"$instance\"}) / max(edg_core_js_stream_max_bytes{job=\"edg-core\", instance=~\"$instance\"})",
          "legendFormat": "used",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Ingest and storage rates",
      "description": "Messages received on platform.data.asset, published to JetStream, and points accepted by VictoriaMetrics. sink_lines counts line-protocol lines, i.e. time series points -- not messages -- so it is expected to differ.",
      "gridPos": {
        "h": 6,
        "w": 14,
        "x": 10,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "showPoints": "never",
            "lineWidth": 2
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "last",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(edg_core_data_messages_received_total{job=\"edg-core\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "received /s",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(edg_core_jetstream_published_total{job=\"edg-core\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "published to JetStream /s",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(edg_core_sink_lines_written_total{job=\"edg-core\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "points written to VM /s",
          "range": true,
          "refId": "C"
        }
      ]
    },
    {
      "type": "row",
      "id": 101,
      "title": "Where data is being lost",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Drops and failures",
      "description": "Every path by which data does not reach storage. Poison acks are batches with nothing numeric to write -- they are dropped, not retried. Fetch errors mean the consumer stopped delivering, which otherwise looks exactly like an idle plant.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "showPoints": "never",
            "lineWidth": 2
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "last",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(edg_core_data_decode_failures_total{job=\"edg-core\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "decode failures /s",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(edg_core_jetstream_publish_failures_total{job=\"edg-core\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "JetStream publish failures /s",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(edg_core_jetstream_dead_letter_failures_total{job=\"edg-core\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "dead-letter failures (data lost) /s",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(edg_core_sink_write_failures_total{job=\"edg-core\", instance=~\"$instance\"}[$__rate_interval])) by (reason)",
          "legendFormat": "sink write failure: {{reason}} /s",
          "range": true,
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(edg_core_sink_messages_acked_total{job=\"edg-core\", instance=~\"$instance\", outcome=\"poison\"}[$__rate_interval]))",
          "legendFormat": "poison acks (dropped) /s",
          "range": true,
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(edg_core_sink_fetch_errors_total{job=\"edg-core\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "sink fetch errors /s",
          "range": true,
          "refId": "F"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(edg_core_nats_slow_consumers_total{job=\"edg-core\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "NATS slow consumers /s",
          "range": true,
          "refId": "G"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "Values by kind",
      "description": "Only kind=number reaches VictoriaMetrics; the sink encoder discards the rest. A plant reporting everything as text produces an empty dashboard and no error.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "showPoints": "never",
            "lineWidth": 2
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "last",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(edg_core_data_values_total{job=\"edg-core\", instance=~\"$instance\"}[$__rate_interval])) by (kind)",
          "legendFormat": "{{kind}} /s",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "id": 102,
      "title": "Latency",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "Ingest handling time (p50 / p95 / p99)",
      "description": "Time spent in HandleAssetData on the NATS delivery goroutine. If this approaches the interval between messages the subscription becomes a slow consumer and NATS drops deliveries with no error anywhere.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "showPoints": "never",
            "lineWidth": 2
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "last",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum(rate(edg_core_data_handle_seconds_bucket{job=\"edg-core\", instance=~\"$instance\"}[$__rate_interval])) by (le))",
          "legendFormat": "p50",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(edg_core_data_handle_seconds_bucket{job=\"edg-core\", instance=~\"$instance\"}[$__rate_interval])) by (le))",
          "legendFormat": "p95",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum(rate(edg_core_data_handle_seconds_bucket{job=\"edg-core\", instance=~\"$instance\"}[$__rate_interval])) by (le))",
          "legendFormat": "p99",
          "range": true,
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Sink write time (p95 / p99)",
      "description": "Round trip to VictoriaMetrics. Compare the tail with sink.request_timeout (5s by default) -- crossing it turns into nakked batches and redelivery.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "showPoints": "never",
            "lineWidth": 2
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "last",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(edg_core_sink_write_seconds_bucket{job=\"edg-core\", instance=~\"$instance\"}[$__rate_interval])) by (le))",
          "legendFormat": "p95",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum(rate(edg_core_sink_write_seconds_bucket{job=\"edg-core\", instance=~\"$instance\"}[$__rate_interval])) by (le))",
          "legendFormat": "p99",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Metadata query time (p95)",
      "description": "The enricher's recursive ancestor CTE, and time callers spend queued for the single SQLite connection. On SD-card storage this is usually where ingest latency comes from.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "showPoints": "never",
            "lineWidth": 2
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "last",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(edg_core_enricher_ancestor_lookup_seconds_bucket{job=\"edg-core\", instance=~\"$instance\"}[$__rate_interval])) by (le))",
          "legendFormat": "ancestor lookup p95",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(edg_core_store_connection_wait_seconds_total{job=\"edg-core\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "connection wait /s",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "type": "row",
      "id": 103,
      "title": "Adapters",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Adapters by availability",
      "description": "Derived from staleness, not from what adapters report: an adapter that crashed cannot publish that it stopped (ADR 0008).",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "showPoints": "never",
            "lineWidth": 2
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "last",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(edg_core_adapters{job=\"edg-core\", instance=~\"$instance\"}) by (availability)",
          "legendFormat": "{{availability}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Adapter publish rate",
      "description": "Derived by the core from each adapter's own counter deltas over receive time, so it holds even when the adapter's clock is wrong.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "showPoints": "never",
            "lineWidth": 2
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "hertz"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "last",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "edg_core_adapter_publish_hz{job=\"edg-core\", instance=~\"$instance\"}",
          "legendFormat": "{{adapter_id}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "id": 11,
      "title": "Runtime drift issues",
      "description": "Assets claimed by more than one adapter, and adapters reporting assets with no master-data record. Details at GET /api/v1/adapters/drift.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max(edg_core_adapter_drift_issues{job=\"edg-core\", instance=~\"$instance\"})",
          "legendFormat": "issues",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "id": 104,
      "title": "The box",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "Memory",
      "description": "Resident set size is what the OOM killer looks at. go_memstats_sys_bytes is what the Go runtime asked the OS for; a large and growing gap is fragmentation or non-Go memory.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "showPoints": "never",
            "lineWidth": 2
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "last",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "process_resident_memory_bytes{job=\"edg-core\", instance=~\"$instance\"}",
          "legendFormat": "RSS",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "go_memstats_sys_bytes{job=\"edg-core\", instance=~\"$instance\"}",
