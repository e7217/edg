FROM victoriametrics/victoria-metrics:v1.133.0

# Pinned for reproducibility, and to the same version the release bundle ships
# (VM_VERSION in .github/workflows/release.yml) and test/e2e runs against. The
# two had drifted to v1.96.0 here and v1.133.0 in the bundle.

# Scrape configuration for the built-in Prometheus-compatible scraper, enabled
# by -promscrape.config in compose.yml (ADR 0009).
COPY deploy/configs/victoriametrics/scrape.yml /etc/vm/scrape.yml
