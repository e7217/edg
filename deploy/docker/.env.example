# Docker Compose Environment Variables
# Copy this file to .env and customize as needed

# Image version tag (default: latest)
# Used for tagging Docker images during build
VERSION=latest

# Which deploy/configs/core/config.<ENV>.yaml the image is built against.
#
# It is a BUILD arg, so changing it needs `docker compose build edg-core`, not
# just a restart.
#
# Leave it at prod for the compose stack. `dev` binds metrics to 127.0.0.1,
# which is correct for running the binary on a laptop but leaves
# VictoriaMetrics unable to scrape edg-core across the compose network, and it
# runs NATS in `compat` mode instead of `strict`.
ENV=prod
